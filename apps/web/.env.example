# KoalaPad — web app (Vite)
# Copy to `.env` and fill in. Never commit the real `.env`.
#
# WARNING: every VITE_* variable is inlined into the client bundle and is
# therefore PUBLIC. Only put values here that are safe to expose in a browser.
# ---------------------------------------------------------------------------

# --- Smart contracts (BNB Smart Chain Testnet, chainId 97) -----------------

# LaunchpadFactory: deploys Token / Pool / ICO / AirdropVault
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# ProtocolTreasury: used by the Shop page
VITE_PROTOCOL_TREASURY=0x0000000000000000000000000000000000000000

# LuckyWheel: used by the Lucky Wheel page
VITE_WHEEL_TREASURY=0x0000000000000000000000000000000000000000

# --- RPC -------------------------------------------------------------------

# Read-only JSON-RPC endpoint: wagmi transport + tx-receipt polling.
VITE_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# --- Supabase (database + edge functions) ----------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key ONLY. Never put the service role key here.
VITE_SUPABASE_KEY=your-supabase-anon-public-key

# --- Privy (authentication) ------------------------------------------------

VITE_PRIVY_APP_ID=your-privy-app-id

# --- Moralis (wallet balances in the Balances tab) -------------------------

# NOTE: this key is shipped to the browser and can be read by anyone using the
# app. Use a key restricted to read-only endpoints/domains, or move the call
# behind a Supabase edge function.
VITE_MORALIS_API_KEY=your-moralis-api-key
